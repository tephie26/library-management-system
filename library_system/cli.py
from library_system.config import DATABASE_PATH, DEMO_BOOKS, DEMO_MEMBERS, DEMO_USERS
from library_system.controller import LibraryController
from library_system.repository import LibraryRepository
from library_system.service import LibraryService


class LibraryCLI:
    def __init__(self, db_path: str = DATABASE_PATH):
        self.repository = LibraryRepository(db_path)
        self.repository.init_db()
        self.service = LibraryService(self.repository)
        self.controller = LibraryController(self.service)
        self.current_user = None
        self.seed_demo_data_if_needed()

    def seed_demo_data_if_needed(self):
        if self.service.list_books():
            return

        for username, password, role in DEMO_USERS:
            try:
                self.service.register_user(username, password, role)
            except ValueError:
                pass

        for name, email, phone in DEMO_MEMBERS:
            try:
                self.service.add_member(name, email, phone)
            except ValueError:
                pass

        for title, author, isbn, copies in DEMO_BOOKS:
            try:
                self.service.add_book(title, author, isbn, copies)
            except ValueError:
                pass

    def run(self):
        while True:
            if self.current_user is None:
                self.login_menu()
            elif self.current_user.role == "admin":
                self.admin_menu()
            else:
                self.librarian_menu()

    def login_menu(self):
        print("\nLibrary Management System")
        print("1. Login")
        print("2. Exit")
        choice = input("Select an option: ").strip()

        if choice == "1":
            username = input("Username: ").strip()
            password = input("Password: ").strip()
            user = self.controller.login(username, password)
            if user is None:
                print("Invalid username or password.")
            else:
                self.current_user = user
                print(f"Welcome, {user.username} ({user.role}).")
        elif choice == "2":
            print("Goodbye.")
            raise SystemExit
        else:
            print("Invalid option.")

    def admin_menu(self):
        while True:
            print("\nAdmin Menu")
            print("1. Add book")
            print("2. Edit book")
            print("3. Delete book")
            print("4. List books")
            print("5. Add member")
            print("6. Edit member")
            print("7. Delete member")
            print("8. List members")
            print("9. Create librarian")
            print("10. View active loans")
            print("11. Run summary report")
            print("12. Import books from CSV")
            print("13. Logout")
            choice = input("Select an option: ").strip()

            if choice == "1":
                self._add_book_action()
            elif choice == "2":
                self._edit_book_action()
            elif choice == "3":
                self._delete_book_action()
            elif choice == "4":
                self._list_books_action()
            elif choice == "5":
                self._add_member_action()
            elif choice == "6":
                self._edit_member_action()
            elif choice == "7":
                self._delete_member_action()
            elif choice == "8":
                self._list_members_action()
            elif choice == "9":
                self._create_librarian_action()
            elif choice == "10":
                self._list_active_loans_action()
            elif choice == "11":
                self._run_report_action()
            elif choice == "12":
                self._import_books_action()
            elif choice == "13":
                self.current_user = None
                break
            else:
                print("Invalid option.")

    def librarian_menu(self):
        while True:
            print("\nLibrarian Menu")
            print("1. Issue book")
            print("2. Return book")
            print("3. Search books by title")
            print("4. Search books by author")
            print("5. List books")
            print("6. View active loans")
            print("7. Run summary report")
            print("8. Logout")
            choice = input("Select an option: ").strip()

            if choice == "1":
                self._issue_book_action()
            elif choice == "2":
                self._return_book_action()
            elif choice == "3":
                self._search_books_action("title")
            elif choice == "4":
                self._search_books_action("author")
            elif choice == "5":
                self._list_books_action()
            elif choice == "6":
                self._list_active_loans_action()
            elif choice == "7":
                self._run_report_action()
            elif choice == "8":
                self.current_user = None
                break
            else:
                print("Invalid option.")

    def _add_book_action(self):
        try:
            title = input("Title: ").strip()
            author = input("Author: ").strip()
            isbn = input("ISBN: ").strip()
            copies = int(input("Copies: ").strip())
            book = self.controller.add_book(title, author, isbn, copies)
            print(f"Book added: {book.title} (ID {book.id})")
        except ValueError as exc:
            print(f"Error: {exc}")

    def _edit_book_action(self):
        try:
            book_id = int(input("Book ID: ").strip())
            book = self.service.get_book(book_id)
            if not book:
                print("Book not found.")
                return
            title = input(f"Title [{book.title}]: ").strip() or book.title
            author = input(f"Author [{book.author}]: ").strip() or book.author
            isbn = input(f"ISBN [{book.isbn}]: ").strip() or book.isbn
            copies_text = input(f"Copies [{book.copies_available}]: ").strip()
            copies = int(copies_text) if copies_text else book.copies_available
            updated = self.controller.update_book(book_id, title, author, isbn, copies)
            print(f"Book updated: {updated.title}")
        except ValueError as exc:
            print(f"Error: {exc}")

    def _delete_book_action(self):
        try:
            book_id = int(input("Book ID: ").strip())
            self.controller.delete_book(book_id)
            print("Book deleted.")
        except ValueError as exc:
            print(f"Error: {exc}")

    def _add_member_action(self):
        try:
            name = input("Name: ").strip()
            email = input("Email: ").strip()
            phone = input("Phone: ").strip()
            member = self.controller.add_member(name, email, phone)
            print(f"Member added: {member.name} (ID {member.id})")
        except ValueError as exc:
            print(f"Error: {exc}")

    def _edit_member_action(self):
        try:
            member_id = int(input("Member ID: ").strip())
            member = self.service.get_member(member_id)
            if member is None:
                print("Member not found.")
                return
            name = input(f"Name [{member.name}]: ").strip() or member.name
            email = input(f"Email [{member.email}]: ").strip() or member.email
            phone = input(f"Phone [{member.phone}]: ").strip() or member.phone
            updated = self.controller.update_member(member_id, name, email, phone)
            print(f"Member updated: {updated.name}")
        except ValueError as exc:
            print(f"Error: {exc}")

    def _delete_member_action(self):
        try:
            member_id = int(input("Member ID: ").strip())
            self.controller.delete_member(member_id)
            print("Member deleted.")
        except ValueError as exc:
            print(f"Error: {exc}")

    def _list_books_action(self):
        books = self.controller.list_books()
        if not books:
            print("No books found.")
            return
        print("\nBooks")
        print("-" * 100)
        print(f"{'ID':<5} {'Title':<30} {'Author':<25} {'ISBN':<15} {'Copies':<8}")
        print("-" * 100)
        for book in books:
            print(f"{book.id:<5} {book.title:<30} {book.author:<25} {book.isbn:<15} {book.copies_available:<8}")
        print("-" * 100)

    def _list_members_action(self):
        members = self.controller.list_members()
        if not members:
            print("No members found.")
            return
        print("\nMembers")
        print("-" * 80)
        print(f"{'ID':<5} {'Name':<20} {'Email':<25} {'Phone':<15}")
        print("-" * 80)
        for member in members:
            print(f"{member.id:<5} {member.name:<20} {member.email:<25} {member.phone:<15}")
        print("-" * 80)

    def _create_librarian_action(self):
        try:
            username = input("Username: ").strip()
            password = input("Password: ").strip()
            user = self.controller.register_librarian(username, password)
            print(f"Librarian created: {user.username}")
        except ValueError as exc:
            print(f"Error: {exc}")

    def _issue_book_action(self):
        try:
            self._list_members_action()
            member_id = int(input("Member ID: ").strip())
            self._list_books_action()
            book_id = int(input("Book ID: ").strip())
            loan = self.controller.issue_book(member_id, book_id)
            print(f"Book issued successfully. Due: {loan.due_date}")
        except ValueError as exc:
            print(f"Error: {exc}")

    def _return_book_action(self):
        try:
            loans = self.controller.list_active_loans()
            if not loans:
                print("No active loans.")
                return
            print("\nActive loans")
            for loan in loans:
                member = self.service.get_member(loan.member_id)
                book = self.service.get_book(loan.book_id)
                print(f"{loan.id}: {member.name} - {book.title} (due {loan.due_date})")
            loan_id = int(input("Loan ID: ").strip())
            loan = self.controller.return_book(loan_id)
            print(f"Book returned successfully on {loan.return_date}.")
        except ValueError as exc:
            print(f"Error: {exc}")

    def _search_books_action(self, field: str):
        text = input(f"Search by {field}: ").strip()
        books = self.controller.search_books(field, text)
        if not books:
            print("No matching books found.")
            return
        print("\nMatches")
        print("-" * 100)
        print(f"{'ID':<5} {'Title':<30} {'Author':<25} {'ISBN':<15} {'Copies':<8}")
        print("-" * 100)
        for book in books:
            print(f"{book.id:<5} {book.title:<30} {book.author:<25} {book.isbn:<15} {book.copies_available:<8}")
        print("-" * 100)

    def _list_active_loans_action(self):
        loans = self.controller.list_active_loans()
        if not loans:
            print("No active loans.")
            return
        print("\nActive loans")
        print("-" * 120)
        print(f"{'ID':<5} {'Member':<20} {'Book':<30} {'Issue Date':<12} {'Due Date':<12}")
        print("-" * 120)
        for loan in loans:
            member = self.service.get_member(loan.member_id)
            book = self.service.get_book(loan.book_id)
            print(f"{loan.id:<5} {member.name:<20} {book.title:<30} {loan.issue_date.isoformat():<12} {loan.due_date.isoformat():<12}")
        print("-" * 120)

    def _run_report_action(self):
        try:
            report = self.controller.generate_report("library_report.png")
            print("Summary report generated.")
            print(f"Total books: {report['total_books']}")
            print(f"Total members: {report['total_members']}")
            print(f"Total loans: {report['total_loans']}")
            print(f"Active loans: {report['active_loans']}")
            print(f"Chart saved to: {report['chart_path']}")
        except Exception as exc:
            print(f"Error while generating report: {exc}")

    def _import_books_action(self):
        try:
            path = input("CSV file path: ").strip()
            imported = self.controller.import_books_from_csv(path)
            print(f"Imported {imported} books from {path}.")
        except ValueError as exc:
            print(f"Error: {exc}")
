from library_system.service import LibraryService


class LibraryController:
    def __init__(self, service: LibraryService):
        self.service = service

    def login(self, username: str, password: str):
        return self.service.authenticate(username, password)

    def register_librarian(self, username: str, password: str):
        return self.service.register_user(username, password, "librarian")

    def add_book(self, title: str, author: str, isbn: str, copies: int):
        return self.service.add_book(title, author, isbn, copies)

    def list_books(self):
        return self.service.list_books()

    def search_books(self, field: str, text: str):
        return self.service.search_books(field, text)

    def add_member(self, name: str, email: str, phone: str):
        return self.service.add_member(name, email, phone)

    def list_members(self):
        return self.service.list_members()

    def update_member(self, member_id: int, name: str, email: str, phone: str):
        return self.service.update_member(member_id, name, email, phone)

    def delete_member(self, member_id: int):
        return self.service.delete_member(member_id)

    def update_book(self, book_id: int, title: str, author: str, isbn: str, copies: int):
        return self.service.update_book(book_id, title, author, isbn, copies)

    def delete_book(self, book_id: int):
        return self.service.delete_book(book_id)

    def issue_book(self, member_id: int, book_id: int):
        return self.service.issue_book(member_id, book_id)

    def return_book(self, loan_id: int):
        return self.service.return_book(loan_id)

    def list_active_loans(self):
        return self.service.list_active_loans()

    def generate_report(self, output_path: str = "library_report.png"):
        return self.service.generate_report(output_path)

    def import_books_from_csv(self, csv_path: str):
        return self.service.import_books_from_csv(csv_path)
