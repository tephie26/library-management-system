from library_system.models import User, Member, Book, Loan
from library_system.database import Database
from datetime import date, timedelta
from typing import Optional, List


class LibraryRepository:
    def __init__(self, db_path: str):
        self.db = Database(db_path)

    def init_db(self):
        self.db.init_db()

    def create_user(self, username: str, password_hash: str, role: str) -> int:
        with self.db.connection() as conn:
            cursor = conn.cursor()
            cursor.execute(
                "INSERT INTO users (username, password_hash, role) VALUES (?, ?, ?)",
                (username, password_hash, role),
            )
            conn.commit()
            return int(cursor.lastrowid)

    def get_user_by_username(self, username: str) -> Optional[User]:
        with self.db.connection() as conn:
            row = conn.execute(
                "SELECT id, username, password_hash, role FROM users WHERE username = ?",
                (username,),
            ).fetchone()
            if row is None:
                return None
            return User(
                id=row["id"],
                username=row["username"],
                password_hash=row["password_hash"],
                role=row["role"],
            )

    def create_member(self, name: str, email: str, phone: str) -> int:
        with self.db.connection() as conn:
            cursor = conn.cursor()
            cursor.execute(
                "INSERT INTO members (name, email, phone) VALUES (?, ?, ?)",
                (name, email, phone),
            )
            conn.commit()
            return int(cursor.lastrowid)

    def get_member(self, member_id: int) -> Optional[Member]:
        with self.db.connection() as conn:
            row = conn.execute(
                "SELECT id, name, email, phone FROM members WHERE id = ?",
                (member_id,),
            ).fetchone()
            if row is None:
                return None
            return Member(
                id=row["id"],
                name=row["name"],
                email=row["email"],
                phone=row["phone"],
            )

    def list_members(self) -> List[Member]:
        with self.db.connection() as conn:
            rows = conn.execute(
                "SELECT id, name, email, phone FROM members ORDER BY name"
            ).fetchall()
            return [
                Member(
                    id=row["id"],
                    name=row["name"],
                    email=row["email"],
                    phone=row["phone"],
                )
                for row in rows
            ]

    def update_member(self, member_id: int, name: str, email: str, phone: str):
        with self.db.connection() as conn:
            conn.execute(
                "UPDATE members SET name = ?, email = ?, phone = ? WHERE id = ?",
                (name, email, phone, member_id),
            )
            conn.commit()

    def delete_member(self, member_id: int):
        with self.db.connection() as conn:
            conn.execute("DELETE FROM members WHERE id = ?", (member_id,))
            conn.commit()

    def create_book(self, title: str, author: str, isbn: str, copies_available: int) -> int:
        with self.db.connection() as conn:
            cursor = conn.cursor()
            cursor.execute(
                "INSERT INTO books (title, author, isbn, copies_available) VALUES (?, ?, ?, ?)",
                (title, author, isbn, copies_available),
            )
            conn.commit()
            return int(cursor.lastrowid)

    def get_book(self, book_id: int) -> Optional[Book]:
        with self.db.connection() as conn:
            row = conn.execute(
                "SELECT id, title, author, isbn, copies_available FROM books WHERE id = ?",
                (book_id,),
            ).fetchone()
            if row is None:
                return None
            return Book(
                id=row["id"],
                title=row["title"],
                author=row["author"],
                isbn=row["isbn"],
                copies_available=row["copies_available"],
            )

    def list_books(self) -> List[Book]:
        with self.db.connection() as conn:
            rows = conn.execute(
                "SELECT id, title, author, isbn, copies_available FROM books ORDER BY title"
            ).fetchall()
            return [
                Book(
                    id=row["id"],
                    title=row["title"],
                    author=row["author"],
                    isbn=row["isbn"],
                    copies_available=row["copies_available"],
                )
                for row in rows
            ]

    def search_books(self, field: str, text: str) -> List[Book]:
        query = f"SELECT id, title, author, isbn, copies_available FROM books WHERE {field} LIKE ? ORDER BY title"
        with self.db.connection() as conn:
            rows = conn.execute(query, (f"%{text}%",)).fetchall()
            return [
                Book(
                    id=row["id"],
                    title=row["title"],
                    author=row["author"],
                    isbn=row["isbn"],
                    copies_available=row["copies_available"],
                )
                for row in rows
            ]

    def update_book(self, book_id: int, title: str, author: str, isbn: str, copies_available: int):
        with self.db.connection() as conn:
            conn.execute(
                "UPDATE books SET title = ?, author = ?, isbn = ?, copies_available = ? WHERE id = ?",
                (title, author, isbn, copies_available, book_id),
            )
            conn.commit()

    def delete_book(self, book_id: int):
        with self.db.connection() as conn:
            conn.execute("DELETE FROM books WHERE id = ?", (book_id,))
            conn.commit()

    def get_loan(self, loan_id: int) -> Optional[Loan]:
        with self.db.connection() as conn:
            row = conn.execute(
                "SELECT id, member_id, book_id, issue_date, due_date, return_date FROM loans WHERE id = ?",
                (loan_id,),
            ).fetchone()
            if row is None:
                return None
            return Loan(
                id=row["id"],
                member_id=row["member_id"],
                book_id=row["book_id"],
                issue_date=date.fromisoformat(row["issue_date"]),
                due_date=date.fromisoformat(row["due_date"]),
                return_date=date.fromisoformat(row["return_date"]) if row["return_date"] else None,
            )

    def list_loans(self) -> List[Loan]:
        with self.db.connection() as conn:
            rows = conn.execute(
                "SELECT id, member_id, book_id, issue_date, due_date, return_date FROM loans ORDER BY issue_date DESC"
            ).fetchall()
            return [
                Loan(
                    id=row["id"],
                    member_id=row["member_id"],
                    book_id=row["book_id"],
                    issue_date=date.fromisoformat(row["issue_date"]),
                    due_date=date.fromisoformat(row["due_date"]),
                    return_date=date.fromisoformat(row["return_date"]) if row["return_date"] else None,
                )
                for row in rows
            ]

    def list_active_loans(self) -> List[Loan]:
        with self.db.connection() as conn:
            rows = conn.execute(
                "SELECT id, member_id, book_id, issue_date, due_date, return_date FROM loans WHERE return_date IS NULL ORDER BY issue_date DESC"
            ).fetchall()
            return [
                Loan(
                    id=row["id"],
                    member_id=row["member_id"],
                    book_id=row["book_id"],
                    issue_date=date.fromisoformat(row["issue_date"]),
                    due_date=date.fromisoformat(row["due_date"]),
                    return_date=None,
                )
                for row in rows
            ]

    def issue_book_transaction(self, member_id: int, book_id: int, issue_date: date, due_date: date) -> Loan:
        with self.db.connection() as conn:
            conn.execute("BEGIN IMMEDIATE")

            member_row = conn.execute("SELECT id FROM members WHERE id = ?", (member_id,)).fetchone()
            if member_row is None:
                raise ValueError("Member not found.")

            book_row = conn.execute(
                "SELECT id, copies_available, title FROM books WHERE id = ?",
                (book_id,),
            ).fetchone()
            if book_row is None:
                raise ValueError("Book not found.")

            if book_row["copies_available"] <= 0:
                raise ValueError("No copies available for this book.")

            active_loan = conn.execute(
                "SELECT id FROM loans WHERE member_id = ? AND book_id = ? AND return_date IS NULL",
                (member_id, book_id),
            ).fetchone()
            if active_loan is not None:
                raise ValueError("This member already has an active loan for that book.")

            cursor = conn.cursor()
            cursor.execute(
                "INSERT INTO loans (member_id, book_id, issue_date, due_date, return_date) VALUES (?, ?, ?, ?, NULL)",
                (member_id, book_id, issue_date.isoformat(), due_date.isoformat()),
            )
            loan_id = int(cursor.lastrowid)

            conn.execute(
                "UPDATE books SET copies_available = copies_available - 1 WHERE id = ?",
                (book_id,),
            )
            conn.commit()

            return Loan(
                id=loan_id,
                member_id=member_id,
                book_id=book_id,
                issue_date=issue_date,
                due_date=due_date,
                return_date=None,
            )

    def return_book_transaction(self, loan_id: int, return_date: date) -> Loan:
        with self.db.connection() as conn:
            conn.execute("BEGIN IMMEDIATE")

            loan_row = conn.execute(
                "SELECT id, member_id, book_id, issue_date, due_date, return_date FROM loans WHERE id = ?",
                (loan_id,),
            ).fetchone()

            if loan_row is None:
                raise ValueError("Loan not found.")
            if loan_row["return_date"] is not None:
                raise ValueError("This loan has already been returned.")

            conn.execute(
                "UPDATE loans SET return_date = ? WHERE id = ?",
                (return_date.isoformat(), loan_id),
            )
            conn.execute(
                "UPDATE books SET copies_available = copies_available + 1 WHERE id = ?",
                (loan_row["book_id"],),
            )
            conn.commit()

            return Loan(
                id=loan_row["id"],
                member_id=loan_row["member_id"],
                book_id=loan_row["book_id"],
                issue_date=date.fromisoformat(loan_row["issue_date"]),
                due_date=date.fromisoformat(loan_row["due_date"]),
                return_date=return_date,
            )
